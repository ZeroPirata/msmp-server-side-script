{
  "compilerOptions": {
    /* --- Configurações de Compilação e Linguagem --- */
    "target": "es2018", // Otimizado para Rhino moderno
    "module": "node16", // Evita geração de código "exports" do CommonJS que quebra o KubeJS
    "moduleResolution": "node16",
    "lib": ["es2018", "dom"], // "dom" às vezes ajuda com timers (setTimeout), mas es2018 é o principal

    /* --- Comportamento --- */
    "strict": true,
    "noImplicitAny": false, // KubeJS as vezes tem tipos dinâmicos, 'false' pode poupar dor de cabeça
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,

    /* --- Saída --- */
    // AVISO: Se você tiver scripts de STARTUP, mude isso ou mova os arquivos manualmente
    "outDir": "../server_scripts",
    "rootDir": "./src",
    "removeComments": true, // Deixa o arquivo final mais limpo para o Rhino ler

    /* --- Integração com ProbeJS (Vital) --- */
    // Garante que o VS Code olhe para os dumps gerados pelo ProbeJS
    "typeRoots": ["./node_modules/@types", "../../.probe/server", "../../.probe/client", "../../.probe/startup", "../../.probe/packages"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "../../.probe/server", // Excluímos da compilação, mantemos apenas no typeRoots
    "../../.probe/client",
    "../../.probe/startup"
  ]
}
